# Cloudinary Configuration for Image Uploads
# Get these from your Cloudinary Dashboard: https://cloudinary.com/console

VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name-here
VITE_CLOUDINARY_UPLOAD_PRESET=products

# Backend API base URL (optional)
# - Leave unset/empty to use same-origin `/api` (recommended for tunnels + Vite proxy).
# - Set to a full URL only when you have a separately reachable backend (e.g. hosted or separately tunneled).
# VITE_API_URL=
